extraStyles: |
  <style>
    .hero {
      position: relative;
      padding: clamp(9rem, 18vw, 16rem) 0 clamp(4rem, 10vw, 8rem);
    }

    .hero-inner {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .hero-label {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.9rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-tertiary);
    }

    .hero-label::before {
      content: ">";
      color: var(--accent);
    }

    .hero-title {
      font-family: var(--font-display);
      font-weight: 500;
      letter-spacing: -0.06em;
      font-size: clamp(6rem, 18vw, 16rem);
      line-height: 0.8;
      text-transform: lowercase;
      -webkit-text-stroke: 1px rgba(248, 250, 252, 0.9);
      color: transparent;
      transition: color var(--transition-slow), -webkit-text-stroke var(--transition-slow);
      width: fit-content;
    }

    .hero-title:hover {
      color: var(--text-primary);
      -webkit-text-stroke: 1px transparent;
    }

    .hero-subtitle {
      font-family: var(--font-mono);
      font-size: clamp(0.95rem, 2vw, 1rem);
      color: var(--text-secondary);
      max-width: 78ch;
      line-height: 1.9;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      margin-top: 1rem;
    }

    .status-bar {
      margin-top: clamp(3rem, 8vw, 6rem);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 0.9rem 0;
    }

    .status-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 1.6rem;
      font-family: var(--font-mono);
      font-size: 0.88rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-tertiary);
    }

    .status-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 0 6px rgba(0, 229, 255, 0.05);
    }

    .bento-section {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: clamp(1rem, 2vw, 1.4rem);
    }

    .bento-section .card {
      grid-column: span 6;
    }

    .bento-section .card-wide {
      grid-column: span 12;
    }

    @media (max-width: 920px) {
      .bento-section .card {
        grid-column: span 12;
      }
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1rem, 2vw, 1.4rem);
    }

    @media (max-width: 920px) {
      .projects-grid {
        grid-template-columns: 1fr;
      }
    }

    .log-section {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .cta-block {
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
      padding: clamp(2rem, 6vw, 4rem);
    }

    .cta-label {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-tertiary);
    }

    .cta-label::before {
      content: ">";
      color: var(--accent);
      margin-right: 0.5rem;
    }

    .cta-title {
      font-family: var(--font-display);
      font-weight: 500;
      letter-spacing: -0.02em;
      font-size: clamp(1.8rem, 5vw, 3.2rem);
      line-height: 1.08;
    }
  </style>
