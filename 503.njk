---
layout: base.njk
permalink: /503.html
headExtra: |
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
extraStyles: |
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; font-family: "Inter", "Noto Sans JP", sans-serif; }
    body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      overflow: hidden;
      background: var(--bg);
      color: var(--text);
    }

    .scene { position: relative; width: min(760px, calc(100vw - 2rem)); padding: 2rem; }

    .card {
      position: relative;
      z-index: 1;
      background: var(--white);
      border: 1px solid rgba(226, 232, 240, 0.8);
      border-radius: 32px;
      box-shadow: 0 30px 60px rgba(15, 23, 42, 0.08);
      backdrop-filter: blur(10px);
      padding: clamp(2rem, 4vw, 3.5rem);
      text-align: center;
    }

    .badge {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.5rem 0.9rem; border-radius: 999px;
      background: rgba(0, 191, 255, 0.12);
      border: 1px solid rgba(0, 191, 255, 0.15);
      color: var(--primary);
      font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    }
    .badge .dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 12px rgba(34, 197, 94, 0.8); animation: pulse 1.8s ease-in-out infinite; }

    .error-code {
      margin: 1.25rem 0 0.5rem;
      font-size: clamp(5rem, 12vw, 9rem); font-weight: 900;
      letter-spacing: -0.08em; line-height: 0.9;
      color: transparent;
      background: linear-gradient(135deg, var(--accent) 0%, var(--primary) 45%, var(--primary-light) 100%);
      -webkit-background-clip: text; background-clip: text;
      text-shadow: 0 12px 28px rgba(0, 191, 255, 0.18);
    }

    .title { margin: 0 0 0.9rem; font-size: clamp(1.8rem, 4vw, 2.5rem); letter-spacing: -0.05em; color: var(--dark); }
    .message { max-width: 540px; margin: 0 auto; color: var(--text-light); font-size: 1.04rem; line-height: 1.8; }
    .message strong { color: var(--dark); }

    .actions { margin-top: 2rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
    .btn { display: inline-flex; align-items: center; justify-content: center; min-width: 160px; padding: 0.9rem 1.35rem; border-radius: 14px; text-decoration: none; font-weight: 700; transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease; }
    .btn:hover { transform: translateY(-2px); }
    .btn-primary { background: var(--gradient-accent); color: var(--white); box-shadow: 0 12px 24px rgba(0, 191, 255, 0.18); }
    .btn-secondary { background: var(--bg); color: var(--dark); border: 1px solid rgba(226, 232, 240, 0.8); }

    .meta { margin-top: 2rem; color: var(--text-light); font-size: 0.92rem; }
    .meta a { color: var(--primary); text-decoration: none; border-bottom: 1px solid rgba(0, 82, 204, 0.3); }

    @keyframes pulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.15); opacity: 0.8; } }
    @media (max-width: 640px) { .scene { width: min(100vw - 1rem, 520px); padding: 0.75rem; } .actions { flex-direction: column; } .btn { width: 100%; } }
  </style>
headerContent: ""
mainContent: |
  <div class="scene" aria-live="polite">
    <main class="card">
      <div class="badge"><span class="dot"></span> Service Unavailable</div>
      <div class="error-code">503</div>
      <h1 class="title">サービス一時停止中</h1>
      <p class="message">現在メンテナンス中のため、サービスをご利用いただけません。<br>しばらく経ってから再度お試しください。</p>

      <div class="actions">
        <a href="/" class="btn btn-primary" data-t="btn_home">ホームへ戻る</a>
        <a href="javascript:location.reload()" class="btn btn-secondary" data-t="btn_reload">更新する</a>
      </div>

      <p class="meta">
        それでも見つからない場合は、<a href="https://fo.ryopc.org/" data-t="support_link">サポート</a>へどうぞ。
      </p>
    </main>
  </div>