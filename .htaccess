# ==== MAINTENANCE MODE (既存 .htaccess の最上部に貼る) ====
# Better Stack のメンテナンスを自動同期 (sync.php を定期実行)
ErrorDocument 503 /maintenance.php

<IfModule mod_rewrite.c>
RewriteEngine On

# maintenance.txt が存在するときだけ有効
RewriteCond %{DOCUMENT_ROOT}/maintenance.txt -f

# 除外: メンテ画面 / 同期スクリプト
RewriteCond %{REQUEST_URI} !^/maintenance\.php$
RewriteCond %{REQUEST_URI} !^/sync\.php$

# 除外: 静的ファイル（背景画像・CSS・JS・フォント等）
RewriteCond %{REQUEST_URI} !\.(jpe?g|png|gif|webp|avif|svg|ico|css|js|woff2?)$ [NC]

# 除外: 自分のIP
RewriteCond %{HTTP:CF-Connecting-IP} ^153\.191\.11\.135$

RewriteRule ^ - [R=503,L]
</IfModule>

# ==== /MAINTENANCE MODE ====
SetEnvIf Request_URI ".*" Ngx_Cache_NoCacheMode=off
SetEnvIf Request_URI ".*" Ngx_Cache_StaticMode
<IfModule mod_headers.c>
    # インフレーム防止（既存の設定）
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Content-Security-Policy "frame-ancestors 'self'"

    # 1. ブラウザによる悪意のあるMIMEタイプ判定（中身の改ざん）を防ぐ
    Header set X-Content-Type-Options "nosniff"

    # 2. リンク元URLの情報（リファラー）を必要最小限だけ送信する（プライバシー保護）
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
ErrorDocument 404 /404.html
