<!DOCTYPE html>
<html lang="{{ locale | default('ja') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{{ title | default('ryopc org') }}</title>
  <meta name="description" content="{{ description | default('ryopc org - a voluntary collective leading the Global PC Support Network and various open-source projects.') }}">
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  {{ headExtra | safe }}

  {% include "partials/head-common.njk" %}

  {{ extraStyles | safe }}
</head>
<body>
  <div id="banner"></div>
  <script src="https://keepandroidopen.org/banner.js?id=banner"></script>
  <script src="/js/banner-offset.js" defer></script>

  <div id="scroll-progress"></div>

  {% include "partials/navbar.njk" %}

  {{ headerContent | safe }}

  <main id="contentContainer">
    {{ mainContent | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {% include "partials/cookie-banner.njk" %}
  {% include "partials/chat-button.njk" %}

  {% include "partials/scripts-common.njk" %}

  {% block scripts %}{% endblock %}
</body>
</html>